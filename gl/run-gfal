cp `ls -1 /var/cache/consistency-dump/${RSE}*root_file_counts.json | tail -1` \
  /var/cache/test/${RSE}_${now}_root_file_counts.json

#echo \
time python3 ./xrootd_scanner.py -g \
  -c /var/cache/test/${RSE}_${now}_config.yaml \
  -s /var/cache/test/${RSE}_${now}_stats.json \
  -o /var/cache/test/${RSE}_${now}_R \
